RewriteEngine On
RewriteBase /

# Block access to sensitive files
<FilesMatch "\.(env|htpasswd|log)$">
    Require all denied
</FilesMatch>

# 301 Redirects for Legacy and Alternative URLs
RewriteRule ^equipment-sales/?$ /sales-service [R=301,L]
RewriteRule ^equipment-rental/?$ /rental-service [R=301,L]
RewriteRule ^service-amc/?$ /klean-max-service [R=301,L]
RewriteRule ^machine-repair/?$ /klean-max-service [R=301,L]
RewriteRule ^office-cleaning-services/?$ /office-cleaning [R=301,L]

# Unless directory, remove trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/$ $1 [R=301,L]

# Redirect external .php requests to extensionless url
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[\s?] [NC]
RewriteRule ^([^.]+)\.php$ $1 [R=301,L]

# Resolve .php file for extensionless php urls
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Redirect external .html requests to extensionless url
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html[\s?] [NC]
RewriteRule ^([^.]+)\.html$ $1 [R=301,L]

# Resolve .html file for extensionless html urls
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

